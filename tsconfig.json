{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "jsxImportSource": "@xp/runtime",
    "baseUrl": ".",
    "paths": { "@xp/runtime": ["runtime/index.ts"], "@xp/runtime/*": ["runtime/*"] }
  },
  "include": ["runtime", "examples", "cli", "tests"]
}
