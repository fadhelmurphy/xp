{
  "name": "xp",
  "version": "0.2.0",
  "description": "Tulis komponen sekali (JSX/React/Vue/Svelte), build jadi bundle web dan native, muat lewat URL di web, iOS, dan Android.",
  "type": "module",
  "bin": {
    "xp": "cli/xp.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "cli",
    "runtime",
    "README.md"
  ],
  "scripts": {
    "build": "node cli/xp.mjs build examples --out dist --yes",
    "test": "npm run build && tsx --test tests/*.test.ts tests/*.test.tsx",
    "typecheck": "tsc -p .",
    "serve": "node cli/xp.mjs serve dist --port 4400",
    "e2e": "node tests/e2e/consumer.mjs",
    "sync-fixtures": "node scripts/sync-fixtures.mjs",
    "demo:gif": "node scripts/record-demo.mjs",
    "demo:terminal": "node scripts/record-terminal.mjs",
    "e2e:dev": "node tests/e2e/dev.mjs",
    "e2e:remotes": "node tests/e2e/two-remotes.mjs",
    "e2e:styling": "node tests/e2e/styling.mjs",
    "pack:adapters": "node scripts/pack-adapters.mjs"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@tailwindcss/node": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "playwright-core": "^1.63.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "styled-components": "^6.5.3",
    "svelte": "^5.57.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vue": "^3.5.43"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "private": true
}
